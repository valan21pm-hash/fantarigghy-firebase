{
  "entities": {
    "Giocatore": {
      "title": "Giocatore",
      "description": "Dati statistici e finanziari di un fantallenatore/giocatore",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "saldo": { "type": "number" },
        "gol": { "type": "number" },
        "ammonizioni": { "type": "number" },
        "ultimoRuolo": { "type": "string" },
        "assist": { "type": "number" },
        "espulsioni": { "type": "number" },
        "golSubitiAzione": { "type": "number" },
        "golSubitiRigore": { "type": "number" },
        "golSubitiPiazzato": { "type": "number" },
        "quotaIscrizione": { "type": "number" },
        "attivo": { "type": "boolean" },
        "numeroMaglia": { "type": "number" }
      },
      "required": ["nome", "saldo", "gol", "ammonizioni", "ultimoRuolo", "assist", "espulsioni", "quotaIscrizione", "attivo", "numeroMaglia"]
    },
    "Campo": {
      "title": "Campo",
      "description": "Nomi dei campi da gioco disponibili",
      "type": "object",
      "properties": {
        "nome": { "type": "string" }
      },
      "required": ["nome"]
    },
    "Partita": {
      "title": "Partita",
      "description": "Dati di un match, convocazioni, referto e formazioni",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dataInserimento": { "type": "string" },
        "dettagli": { "type": "string" },
        "costo": { "type": "number" },
        "convocati": { "type": "array" },
        "stato": { "type": "string" },
        "risultato": { "type": "string" },
        "referto": { "type": "array" },
        "formazione": { "type": "object" },
        "inviatoFanta": { "type": "boolean" },
        "rosterSnapshot": { "type": "object" }
      },
      "required": ["id", "dataInserimento", "testo", "costo", "convocati", "stato", "risultato"]
    },
    "Log": {
      "title": "Log",
      "description": "Record di storico/audit delle operazioni effettuate",
      "type": "object",
      "properties": {
        "data": { "type": "string" },
        "operazione": { "type": "string" },
        "importo": { "type": "string" },
        "dettagli": { "type": "string" }
      },
      "required": ["data", "operazione", "importo", "dettagli"]
    },
    "Fantasquadre": {
      "title": "Fantasquadra",
      "description": "Iscrizioni delle fantasquadre dei singoli partecipanti",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomePartecipante": { "type": "string" },
        "nomeFantasquadra": { "type": "string" },
        "giocatoriSelezionati": { "type": "array" },
        "dataInserimento": { "type": "string" },
        "pin": { "type": "string" },
        "email": { "type": "string" },
        "creditoResiduo": { "type": "number" },
        "valoriAcquisto": { "type": "object" },
        "ultimoCambioMatchId": { "type": "string" }
      },
      "required": ["id", "nomePartecipante", "nomeFantasquadra", "giocatoriSelezionati", "pin", "email"]
    },
    "Consiglio": {
      "title": "Consiglio",
      "description": "Suggerimenti o proposte di miglioramento inviati dagli utenti",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "autore": { "type": "string" },
        "testo": { "type": "string" },
        "data": { "type": "string" },
        "letto": { "type": "boolean" }
      },
      "required": ["id", "autore", "testo", "data", "letto"]
    }
  },
  "firestore": {
    "/giocatori/{giocatoreId}": {
      "schema": "Giocatore",
      "description": "Elenco dei giocatori iscritti e delle loro statistiche"
    },
    "/campi/{campoId}": {
      "schema": "Campo",
      "description": "Lista dei campi da gioco registrati"
    },
    "/partite/{partitaId}": {
      "schema": "Partita",
      "description": "Archivio di tutto lo storico delle partite giocate, aperte e chiuse"
    },
    "/logs/{logId}": {
      "schema": "Log",
      "description": "Registro delle operazioni contabili e gestionali"
    },
    "/fantasquadre/{fantasquadraId}": {
      "schema": "Fantasquadre",
      "description": "Fantasquadre registrate dai partecipanti del Fantacalcetto"
    },
    "/consigli/{consiglioId}": {
      "schema": "Consiglio",
      "description": "Consigli e miglioramenti proposti dagli utenti"
    }
  }
}
